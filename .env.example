NODE_ENV=production
PORT=3000
# Your exact public HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=https://your-domain.com
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_database
DB_USER=your_hostinger_database_user
DB_PASSWORD=replace_with_your_database_password
DB_SSL=false
